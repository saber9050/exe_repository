# 依赖库中心 · compose 变量
#
# 复制成同目录的 .env，docker compose 会自动读取：
#   cp deploy.env.example .env
#
# 带「必填」注释的项不能空着：compose 用 ${VAR:?...} 声明了它们，
# 空值会直接启动失败，而不是悄悄回落到代码里的默认值。

# ===== 管理端登录 =====
ADMIN_USER=admin
# 必填。不填会回落到代码里的 dsh@2026，等于没设密码
ADMIN_PASSWORD=
ADMIN_NAME=平台管理员
# 必填。openssl rand -hex 32 生成；改掉后所有已登录会话立即失效
SESSION_SECRET=

# ===== MinIO =====
# 同机（docker 或裸进程）填 host.docker.internal；
# 跨机填内网 IP，例如 172.24.155.130。容器里的 127.0.0.1 是容器自己，别填。
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false

# 必填。manage 要读写 + CreateBucket；portal 复用同一对（生产建议拆分）
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# 可选：给下载页单独的只读凭据，留空则复用上面那对
# PORTAL_MINIO_ACCESS_KEY=
# PORTAL_MINIO_SECRET_KEY=

# 两个服务必须一致，不一致会静默变成空目录
MINIO_BUCKET=dep-artifacts
MINIO_PREFIX=

# 桶不存在时自动创建（默认私有，不挂匿名策略）
MINIO_AUTO_CREATE_BUCKET=true

# ===== 分片 =====
# 不能低于 5 MiB：S3 规范要求除末片外每片 ≥ 5 MiB，配小了会在 complete 被拒
DEP_PART_SIZE=8388608
DEP_MAX_FILE_BYTES=21474836480

# ===== 端口 =====
MANAGE_PORT=8889
PORTAL_PORT=8888

# ===== 构建 =====
# 国内默认 npmmirror；海外构建改成 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# 只有把 MinIO 也纳入 compose 时才需要下面三项
# MINIO_IMAGE=minio/minio:RELEASE.2024-01-16T16-07-38Z
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=
