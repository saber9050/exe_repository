# 依赖库管理端 · 配置模板
# 复制成同目录的 .env 再填值（.env 不进版本库）

# ===== Gitea 制品库 =====
# 资产清单、制品、审计都落在这个仓库里
GITEA_URL=http://47.103.196.145:3000
GITEA_OWNER=
GITEA_REPO=my-dependency
GITEA_BRANCH=main

# 令牌权限：
#   repository: Read and Write  读写 deps/ 下的清单
#   package:    Read and Write  制品走 generic registry
#   user:       Read and Write  仅当需要自动建仓
GITEA_TOKEN=

# 启动时仓库不存在就自动建（需要 user: Read and Write）
GITEA_AUTO_CREATE_REPO=true
GITEA_REPO_PRIVATE=true

# ===== 平台管理员账号（不是 Gitea 账号）=====
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=平台管理员

# 会话签名密钥（HMAC-SHA256）。
#
# 它不是「去哪里申请 / 复制」的东西 —— 服务端用它给登录 token 签名，随便生成
# 一串随机值填进来即可。改掉这个值，所有已登录的会话会立即失效（要重新登录）。
#
# 生成方式，任选一条执行，把输出贴到下面：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#   powershell -Command "[Convert]::ToHexString((1..32 | % { Get-Random -Max 256 }))"
#
# 别用短串或能猜到的词（比如 password、项目名）：拿到这个值的人可以不经密码，
# 直接伪造出管理员 token。留空则回落到代码里的 dev-only-change-me，
# 那串是公开的，等于没有保护 —— 只能在本机调试时用。
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# ===== 运行参数 =====
# 下载端 portal 默认 8787，这里错开
PORT=8788
AUDIT_LIMIT=200
CACHE_TTL_MS=30000
GITEA_TIMEOUT_MS=20000

# ===== 依赖库 =====
# 单文件上限，默认 2 GiB
DEP_MAX_FILE_BYTES=2147483648
# manifest 在仓库里的目录
DEP_GITEA_DIR=deps
