# 依赖库管理端 · 配置模板
# 复制成同目录的 .env 再填值（.env 不进版本库）
#
# 存储只有一个后端：MinIO（S3 协议）。制品、清单、审计都在对象存储里，
# 本地不落任何状态。

# ===== MinIO =====
# endpoint 只填主机名，不要带 http://；端口单独配
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
# 在 MinIO 控制台 Access Keys 里建，桶上授权：
#   管理端  s3:*            on arn:aws:s3:::dep-artifacts/*
#   下载端  s3:GetObject    on arn:aws:s3:::dep-artifacts/deps/* 与 /meta/deps/*
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=dep-artifacts
MINIO_REGION=us-east-1
# 桶内额外前缀，留空表示 deps/ 与 meta/ 直接在桶根
MINIO_PREFIX=

# ===== 分片上传 =====
# 单片大小，默认 8 MiB（S3 规范要求除末片外 ≥ 5 MiB，配小了会被存储拒绝）
DEP_PART_SIZE=8388608
DEP_MAX_PARTS=10000
# 会话有效期，过期后已传分片被 Abort
DEP_UPLOAD_TTL_HOURS=24
# chunk：逐片校验（默认）| full：完成后再全量复算 | none：只校验大小
DEP_VERIFY_MODE=chunk
# 小于此值的文件前端走单请求直传
DEP_CHUNKED_THRESHOLD=33554432
# 单文件上限，默认 20 GiB
DEP_MAX_FILE_BYTES=21474836480

# ===== 平台管理员账号（与对象存储的 key 无关）=====
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=平台管理员

# 会话签名密钥（HMAC-SHA256）。
#
# 它不是「去哪里申请 / 复制」的东西 —— 服务端用它给登录 token 签名，随便生成
# 一串随机值填进来即可。改掉这个值，所有已登录的会话会立即失效（要重新登录）。
#
# 生成方式，任选一条执行，把输出贴到下面：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#   powershell -Command "[Convert]::ToHexString((1..32 | % { Get-Random -Max 256 }))"
#
# 别用短串或能猜到的词（比如 password、项目名）：拿到这个值的人可以不经密码，
# 直接伪造出管理员 token。留空则回落到代码里的 dev-only-change-me，
# 那串是公开的，等于没有保护 —— 只能在本机调试时用。
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# ===== 运行参数 =====
# 下载端 portal 默认 8787，这里错开
PORT=8788
AUDIT_LIMIT=200
CACHE_TTL_MS=30000
