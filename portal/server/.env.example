# Gitea 地址（本地测试指向内网/公网实例）
GITEA_BASE_URL=http://47.103.196.145:3000

# generic registry 的 owner：组织名或用户名
GITEA_OWNER=

# 访问令牌，只读（read:package）即可 —— 服务端用它列包、取文件清单、转发字节。
# 生成方式二选一（令牌只在生成时显示一次，生成后立刻复制保存）：
#
#   1) 网页：登录 Gitea → 右上角头像 → 设置 → 应用 → 生成新令牌，
#      名称随意（如 dep-portal-read），权限只勾 read:package
#
#   2) 命令行（有服务器 shell 权限时）：
#      docker exec -u git gitea gitea admin user generate-access-token \
#        --username zxp --token-name dep-portal-read --scopes read:package --raw
#
# 注意：本文件是示例模板，会进版本库，不要在这里填真实令牌。
#       把真值写到同目录的 .env（已在 .gitignore 中，不会被提交）
GITEA_TOKEN=

# 门面端口，前端 dev server 会代理到这里
PORT=8787
