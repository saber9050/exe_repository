# 依赖库下载页 · 配置模板
# 复制成同目录的 .env 再填值（.env 不进版本库）
#
# 存储只有一个后端：MinIO。这里的配置必须与 manage/server/.env 指向同一个
# 桶与前缀，否则目录会变空（不报错，更难发现）。

# ===== MinIO 只读凭据 =====
# 生产环境单独建一个只读账号，不要复用 manage 的读写密钥：
# 本服务面向客户端下载，凭据暴露面更大。
#   s3:GetObject on arn:aws:s3:::dep-artifacts/deps/*
#   s3:GetObject on arn:aws:s3:::dep-artifacts/meta/deps/*
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=dep-artifacts
MINIO_REGION=us-east-1
MINIO_PREFIX=

# 门面端口
PORT=8787
