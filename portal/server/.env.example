# Gitea 地址（本地测试指向内网/公网实例）
GITEA_BASE_URL=http://47.103.196.145:3000

# 仓库定位：资产清单存在仓库里，不在 generic 包的元数据里
GITEA_OWNER=
GITEA_REPO=my-dependency
GITEA_DEPS_DIR=deps
GITEA_BRANCH=main

# 访问令牌：读 manifest 要 read:repository，转发制品字节要 read:package
# 生成方式二选一（令牌只在生成时显示一次，生成后立刻复制保存）：
#
#   1) 网页：登录 Gitea → 右上角头像 → 设置 → 应用 → 生成新令牌，
#      名称随意（如 dep-portal-read），权限勾 read:package + read:repository
#
#   2) 命令行（有服务器 shell 权限时）：
#      docker exec -u git gitea gitea admin user generate-access-token \
#        --username <用户名> --token-name dep-portal-read \
#        --scopes read:package,read:repository --raw
#
# 注意：本文件是示例模板，会进版本库，不要在这里填真实令牌。
#       把真值写到同目录的 .env（已在 .gitignore 中，不会被提交）
GITEA_TOKEN=

# 门面端口
PORT=8787
